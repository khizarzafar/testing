   "source": [
    "import os, json\n",
    "\n",
    "# Train the final Random Forest on ALL available data -- validated separately in Weeks 5-6\n",
    "# via a held-out client split; this final model is retrained on everything before \"shipping\"\n",
    "# the playbook, which is standard practice once validation is done.\n",
    "numeric_features = ['search_volume', 'competition', 'word_count', 'content_age_days',\n",
    "                     'days_since_last_update', 'ctr', 'avg_position', 'engagement_rate',\n",
    "                     'scroll_rate', 'ai_traffic_pct', 'impressions_90d', 'sessions_90d', 'clicks_90d']\n",
    "X_full = df[numeric_features].apply(pd.to_numeric, errors='coerce').replace([np.inf, -np.inf], np.nan).fillna(0)\n",
    "y_full = df['is_declining_label']\n",
    "\n",
    "rf_final = RandomForestClassifier(n_estimators=300, max_depth=8, min_samples_leaf=20,\n",
    "                                   random_state=RANDOM_STATE, n_jobs=-1)\n",
    "rf_final.fit(X_full, y_full)\n",
    "df['model_score'] = rf_final.predict_proba(X_full)[:, 1]\n",
    "\n",
    "df['reason_code'] = df['archetype_label'].map({\n",
    "    'High-Visibility Decliners': 'high_visibility_decliner',\n",
    "    'Visible but Thin': 'thin_visible_page',\n",
    "    'Fresh but Low-Reach': 'low_reach_needs_promotion',\n",
    "    'Low-Volume Outliers': 'low_volume_low_confidence',\n",
    "})\n",
    "df['action'] = df['archetype_action']\n",
    "df['final_rank'] = df['model_score'].rank(method='first', ascending=False).astype(int)\n",
    "\n",
    "os.makedirs('../outputs', exist_ok=True)\n",
    "os.makedirs('../figures', exist_ok=True)\n",
    "\n",
    "queue_cols = ['content_id', 'client_id', 'final_rank', 'model_score', 'archetype_label',\n",
    "              'reason_code', 'action', 'avg_position', 'impressions_90d', 'ctr',\n",
    "              'is_declining_label']\n",
    "queue = df[queue_cols].sort_values('final_rank')\n",
    "queue.to_csv('../outputs/action_playbook_queue.csv', index=False)\n",
    "print(f\"Wrote {len(queue):,} rows to work/outputs/action_playbook_queue.csv\")\n",
    "\n",
    "# Figure: decay curve (committed to work/figures/ for reuse in the paper)\n",
    "import matplotlib\n",
    "matplotlib.use('Agg')\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 4))\n",
    "ax.bar(decay.index.astype(str), decay['decline_rate'], color='#2F5233')\n",
    "ax.set_ylabel('Decline rate')\n",
    "ax.set_xlabel('Content age')\n",
    "ax.set_title('Decline rate by content age (this dataset)')\n",
    "ax.set_ylim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../figures/decay_by_age.png', dpi=150)\n",
    "plt.close()\n",
    "print(\"Wrote work/figures/decay_by_age.png\")\n",
    "\n",
    "# Metrics JSON -- the receipts the paper's numbers trace back to (committed, unlike the CSV)\n",
    "metrics = {\n",
    "    'validated_precision_at_50': precision_at_50,\n",
    "    'validated_precision_at_50_source': 'w06_validation_audit.ipynb, client-grouped holdout, 6 test clients',\n",
    "    'base_rate': round(float(base_rate), 3),\n",
    "    'archetype_profile': archetype_profile.round(3).reset_index().to_dict(orient='records'),\n",
    "    'archetype_names': archetype_names,\n",
    "    'archetype_actions': archetype_actions,\n",
    "    'decay_by_age': decay.reset_index().to_dict(orient='records'),\n",
    "    'random_state': RANDOM_STATE,\n",
    "}\n",
    "with open('../outputs/action_playbook_metrics.json', 'w') as f:\n",
    "    json.dump(metrics, f, indent=2, default=str)\n",
    "print(\"Wrote work/outputs/action_playbook_metrics.json\")\n",
    "\n",
    "queue.head(10)"
   ]
