    "# Decay insight, computed fresh in this notebook (not just cited from the paper)\n",
    "df['age_bucket'] = pd.cut(df['content_age_days'], bins=[-1, 90, 180, 270, 365, 100000],\n",
    "                           labels=['0-90d', '91-180d', '181-270d', '271-365d', '365d+'])\n",
    "decay = df.groupby('age_bucket', observed=True).agg(\n",
    "    n=('content_id', 'size'), decline_rate=('is_declining_label', 'mean')).round(3)\n",
    "print(\"DECAY INSIGHT -- decline rate by content age (this dataset):\")\n",
    "print(decay)\n",
    "print(\"\\nRuns opposite to the published paper's age-decline direction -- see limits above.\")"
   ]
