    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Archetype profile (verify against the table above):\n",
      "                  n  avg_impressions  avg_position  avg_ctr  decline_rate\n",
      "archetype_id                                                             \n",
      "0              9442          4935.23         22.07     0.20          0.52\n",
      "1             12205          8921.59         16.55     0.28          0.63\n",
      "2               159             4.57          6.46    38.06          0.16\n",
      "3              8194            63.92          9.63     0.48          0.44\n",
      "\n",
      "Assigned: {0: 'Visible but Thin', 1: 'High-Visibility Decliners', 2: 'Low-Volume Outliers', 3: 'Fresh but Low-Reach'}\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "RANDOM_STATE = 42\n",
    "df = pd.read_csv('../../data/raw/content_refresh_anonymized.csv')\n",
    "df['is_declining_label'] = (df['trend_direction'] == 'down').astype(int)\n",
    "\n",
    "# --- Archetypes: light k-means, same as validated in exploration ---\n",
    "cluster_features = ['impressions_90d', 'avg_position', 'ctr', 'days_since_last_update', 'word_count']\n",
    "X_cluster = df[cluster_features].apply(pd.to_numeric, errors='coerce').fillna(0).copy()\n",
    "X_cluster['impressions_90d'] = np.log1p(X_cluster['impressions_90d'])\n",
    "X_scaled = StandardScaler().fit_transform(X_cluster)\n",
    "\n",
    "km = KMeans(n_clusters=4, random_state=RANDOM_STATE, n_init=10)\n",
    "df['archetype_id'] = km.fit_predict(X_scaled)\n",
    "\n",
    "archetype_profile = df.groupby('archetype_id').agg(\n",
    "    n=('content_id', 'size'), avg_impressions=('impressions_90d', 'mean'),\n",
    "    avg_position=('avg_position', 'mean'), avg_ctr=('ctr', 'mean'),\n",
    "    decline_rate=('is_declining_label', 'mean')).round(2)\n",
    "print(\"Archetype profile (verify against the table above):\")\n",
    "print(archetype_profile)\n",
    "\n",
    "# Map cluster IDs to labels/actions by their profile (highest avg_impressions = high-vis, etc.)\n",
    "label_map = archetype_profile.sort_values('avg_impressions', ascending=False).index.tolist()\n",
    "# label_map[0]=highest impressions cluster, etc. -- assign by rule, not by hardcoded id\n",
    "archetype_names, archetype_actions = {}, {}\n",
    "for cid, row in archetype_profile.iterrows():\n",
    "    if row['n'] < 500:\n",
    "        archetype_names[cid], archetype_actions[cid] = 'Low-Volume Outliers', 'exclude_low_confidence'\n",
    "    elif row['avg_impressions'] == archetype_profile['avg_impressions'].max():\n",
    "        archetype_names[cid], archetype_actions[cid] = 'High-Visibility Decliners', 'refresh_priority'\n",
    "    elif row['avg_position'] == archetype_profile.loc[archetype_profile['n'] >= 500, 'avg_position'].max():\n",
    "        archetype_names[cid], archetype_actions[cid] = 'Visible but Thin', 'expand_and_refresh'\n",
    "    else:\n",
    "        archetype_names[cid], archetype_actions[cid] = 'Fresh but Low-Reach', 'monitor_promote'\n",
    "\n",
    "df['archetype_label'] = df['archetype_id'].map(archetype_names)\n",
    "df['archetype_action'] = df['archetype_id'].map(archetype_actions)\n",
    "print(\"\\nAssigned:\", archetype_names)"
   ]
  },
